# Export these in your shell. The CLI does not automatically load .env files.
# Keep real values out of Git and chat. Both models share this OpenRouter key.
OPEN_ROUTER_KEY=
# Text/reasoning LLM used for baseline and fallback:
LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# System One decision model, used only with --system-one jev:
SYSONE_MODEL=typesafe/jev-1.14
# Optional override; OpenRouter is the default:
LLM_BASE_URL=https://openrouter.ai/api/v1
# Hostname only; local Batfish port defaults to 9996:
BATFISH_HOST=localhost
