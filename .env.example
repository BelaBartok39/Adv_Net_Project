# Export these in your shell. The CLI does not automatically load .env files.
# Keep real values out of Git and chat.
TYPESAFE_API_KEY=
JEV_MODEL=jev-latest
# Use exact model IDs accepted by your account. No LLM model is assumed.
LLM_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Only for --llm-provider compatible, e.g. a locally served Qwen checkpoint:
LLM_BASE_URL=
# Batfish verifier service used by the LLM-only experiment runner:
BATFISH_HOST=localhost
